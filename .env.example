# Operating mode — LIVE is gated and disabled by default
OPERATING_MODE=PAPER
ALLOW_LIVE_TRADING=false

# Optional: Jupiter Swap API V2 GET /swap/v2/order quote/route only. Never /execute.
# Ultra is superseded by Swap V2. Without JUPITER_API_KEY the labeled DEMO provider is used.
# Docs: https://developers.jup.ag/docs/swap
JUPITER_API_BASE=https://api.jup.ag/swap/v2
JUPITER_API_KEY=

# Optional x402 V2 premium API (devnet only, off by default)
X402_ENABLED=false
X402_NETWORK=devnet
X402_PAY_TO=
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PRICE_TOKEN_RISK=$0.005
X402_PRICE_WALLET_SCORE=$0.005
X402_PRICE_SIGNAL=$0.001
X402_PRICE_DEEP_ANALYSIS=$0.01

# Optional Helius LaserStream (batch fallback used if unset)
HELIUS_WS_URL=

# Parsed Events host (default mainnet.helius-rpc.com). Enhanced TX remains fallback only.
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com
# HELIUS_API_BASE=https://api.helius.xyz

# Optional: Helius RPC / DAS
HELIUS_API_KEY=
HELIUS_RPC_URL=

# Optional: Birdeye-compatible market data
BIRDEYE_API_KEY=
BIRDEYE_API_BASE=https://public-api.birdeye.so

# Optional: OpenAI-compatible research LLM (mock used if unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
RESEARCH_MODEL=gpt-4o-mini

# Optional: Supabase / Postgres (in-memory demo used if unset)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demo / paper defaults
DEMO_MODE=true
PAPER_STARTING_CAPITAL_USD=100000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_OPERATING_MODE=PAPER

# Bind — default loopback. Remote demo: SAT_BIND_HOST=0.0.0.0 plus SAT_API_TOKEN and SAT_ALLOWED_ORIGINS.
SAT_BIND_HOST=127.0.0.1
SAT_BIND_PORT=4317
SAT_ALLOWED_ORIGINS=
SAT_API_TOKEN=

# Optional public API keys for /api/v1 (comma-separated secret:TIER). Unset = anonymous FREE locally.
# Example: SAT_API_KEYS=local_free:FREE,local_pro:PRO
SAT_API_KEYS=

# Optional Jupiter Tokens API (verified / organic score). Nulls if unset or malformed.
JUPITER_TOKENS_API_BASE=https://api.jup.ag/tokens/v2

# Public portfolio demo — anonymous users are read-only.
PUBLIC_DEMO=false
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MAX=8

# Paper engine realism (set 0 for deterministic E2E)
PAPER_FAIL_PROBABILITY=0.03
PAPER_PARTIAL_PROBABILITY=0.12
