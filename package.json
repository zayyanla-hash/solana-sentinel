{
  "name": "solana-sentinel",
  "private": true,
  "version": "0.3.0",
  "description": "Solana Sentinel — Solana Agentic Trading Research Platform. PAPER ONLY. No live broadcast.",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm secret-scan",
    "benchmark:ingestion": "tsx scripts/benchmark-ingestion.ts",
    "benchmark:monitor": "tsx scripts/benchmark-monitor.ts",
    "staging:start": "python3 scripts/staging-db.py start",
    "staging:stop": "python3 scripts/staging-db.py stop",
    "staging:backup": "python3 scripts/staging-db.py backup",
    "staging:restore-check": "python3 scripts/staging-db.py restore-check",
    "staging:validate": "python3 scripts/validate-staging.py",
    "staging:monitor": "node --env-file=.env.staging.local --import tsx apps/worker/src/monitor.ts",
    "staging:web": "node --env-file=.env.staging.local apps/web/node_modules/next/dist/bin/next start apps/web -H 127.0.0.1 -p 4317",
    "mac:setup": "python3 scripts/mac-release.py setup",
    "mac:install": "python3 scripts/mac-release.py install",
    "mac:start": "python3 scripts/mac-release.py start",
    "mac:stop": "python3 scripts/mac-release.py stop",
    "mac:status": "python3 scripts/mac-release.py status",
    "mac:backup": "python3 scripts/mac-release.py backup",
    "mac:restore-check": "python3 scripts/mac-release.py restore-check",
    "mac:copy-backup": "python3 scripts/mac-release.py copy-backup",
    "mac:configure-copy": "python3 scripts/mac-release.py configure-copy",
    "mac:update": "python3 scripts/mac-release.py update",
    "mac:rollback": "python3 scripts/mac-release.py rollback",
    "mac:uninstall": "python3 scripts/mac-release.py uninstall",
    "monitor": "tsx apps/worker/src/monitor.ts",
    "collect:mainnet": "tsx scripts/collect-mainnet.ts",
    "evaluate:mainnet": "tsx scripts/evaluate-mainnet.ts",
    "build": "pnpm -r --filter=./packages/* run build && pnpm --filter=@sat/web run build && pnpm --filter=@sat/worker run build",
    "dev": "pnpm --filter=@sat/web run dev",
    "dev:worker": "pnpm --filter=@sat/worker run dev",
    "lint": "eslint --max-warnings 0 packages apps/worker apps/cli tests && pnpm --filter @sat/web run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "secret-scan": "bash scripts/secret-scan.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.9"
  },
  "dependencies": {
    "zod": "^3.24.2"
  }
}
